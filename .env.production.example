# === Credential Vault: production environment (Docker Compose on the NAS) ===
# Copy this file to .env.production and fill in every value. NEVER commit it.
#
# Start the stack with:
#   docker compose --env-file .env.production up -d
#
# The backend refuses to start when APP_ENV=production and SECRET_KEY is the
# placeholder, shorter than 32 characters, or APP_DEBUG is true.

# === Application ===
APP_ENV=production
APP_DEBUG=false

# === Security (REQUIRED) ===
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-the-output-of-openssl-rand-hex-32

# === Google OAuth (REQUIRED) ===
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<TS_CERT_DOMAIN>/login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Session Settings ===
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60

# === Initial Admin Bootstrap (optional) ===
# Auto-promote this Google account to admin on first login (only if no admin exists)
# ADMIN_EMAIL=admin@example.com
# ADMIN_DISPLAY_NAME=Administrator
# Break-glass password for local admin login when Google OAuth is unavailable
# ADMIN_PASSWORD=your-strong-breakglass-password

# === Tailscale (REQUIRED) ===
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
# Settings: Reusable=Yes, Ephemeral=No
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_HOSTNAME=credential-vault
TS_CERT_DOMAIN=credential-vault.your-tailnet.ts.net

# Reject requests whose client address is outside the Tailscale CGNAT range
REQUIRE_TAILSCALE=true
