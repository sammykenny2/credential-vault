# === Credential Vault: production environment (Docker Compose) ===
# Copy this file to .env.production and fill in every value. NEVER commit it.
# One copy per Docker host (this Windows machine, a NAS, ...).
#
# Deploy with:
#   .\scripts\windows\Deploy-CredentialVault.ps1
# or on a host without PowerShell:
#   docker compose --env-file .env.production up -d --build
#
# The backend refuses to start when APP_ENV=production and SECRET_KEY is the
# placeholder, shorter than 32 characters, or APP_DEBUG is true.

# === Application ===
APP_ENV=production
APP_DEBUG=false

# === Security (REQUIRED) ===
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-the-output-of-openssl-rand-hex-32

# === Google OAuth (REQUIRED) ===
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<TS_CERT_DOMAIN>/login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Session Settings ===
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60

# === Initial Admin Bootstrap (optional) ===
# Prefer the first-run page instead: with no admin yet, the site opens
# /admin/setup, where the break-glass password is typed in the browser and
# only its bcrypt hash is stored. Then nothing secret has to sit in this file.
# Auto-promote this Google account to admin on first login (only if no admin exists)
# ADMIN_EMAIL=admin@example.com
# ADMIN_DISPLAY_NAME=Administrator
# Break-glass password for local admin login when Google OAuth is unavailable
# ADMIN_PASSWORD=your-strong-breakglass-password

# === Tailscale (REQUIRED) ===
# Optional. Leave empty to add the node through a browser login: the deploy
# script prints the login URL, and no key is stored anywhere. Or generate an
# auth key at https://login.tailscale.com/admin/settings/keys (Ephemeral=No;
# Reusable is not needed) and clear it again after the first deploy: once
# joined, the node identity is kept in the tailscale_state volume.
TS_AUTHKEY=
# Tailnet machine name. Use a different one on each host that runs the stack.
TS_HOSTNAME=credential-vault
# <TS_HOSTNAME>.<tailnet>.ts.net; also the Google redirect URI host (/login)
TS_CERT_DOMAIN=credential-vault.your-tailnet.ts.net

# Image tag the compose file builds and runs (default: local). Set it when
# moving images between hosts with docker save / docker load.
# VAULT_IMAGE_TAG=local

# Reject requests whose client address is outside the Tailscale CGNAT range
REQUIRE_TAILSCALE=true

# === Trusted reverse proxies ===
# X-Forwarded-For is honoured only when the direct connection comes from one
# of these networks (comma-separated CIDRs). Default: loopback and the Docker
# bridge range used by nginx and the tailscale sidecar.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
