# === Credential Vault: local development environment ===
# Copy this file to .env and fill in the values. NEVER commit .env.
# Docker/NAS deployment uses .env.production (see .env.production.example).

# === Application ===
APP_ENV=development
APP_DEBUG=true

# === Security ===
# Any value works for local development. Production refuses to start with
# this placeholder or anything shorter than 32 characters.
SECRET_KEY=change-this-secret-key-in-production

# === Database ===
# Default uses SQLite (zero config). Override to use a different path:
# DATABASE_URL=sqlite+aiosqlite:///data/credential_vault.db

# === Google OAuth (REQUIRED for Google sign-in) ===
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000/login as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Session Settings ===
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60

# === Initial Admin Bootstrap (optional) ===
# Auto-promote this Google account to admin on first login (only if no admin exists)
# ADMIN_EMAIL=admin@example.com
# ADMIN_DISPLAY_NAME=Administrator
# Break-glass password for local admin login via POST /auth/login
# ADMIN_PASSWORD=your-strong-breakglass-password

# === Tailscale ===
# Local development is reached over localhost, so the Tailscale source check is off.
REQUIRE_TAILSCALE=false
# The Tailscale sidecar runs only in the Docker deployment, which reads these
# from .env.production (see .env.production.example for what each one does).
# Local development does not use them; they are listed so that both files
# name the same settings.
# Empty TS_AUTHKEY: approve the node through a browser login instead of a key.
# TS_AUTHKEY=
# Tailnet machine name; use a different one on each host that runs the stack.
# TS_HOSTNAME=credential-vault
# <TS_HOSTNAME>.<tailnet>.ts.net; also the host of the Google redirect URI.
# TS_CERT_DOMAIN=credential-vault.your-tailnet.ts.net

# === Trusted reverse proxies ===
# X-Forwarded-For is honoured only when the direct connection comes from one
# of these networks (comma-separated CIDRs). Default: loopback and the Docker
# bridge range used by nginx and the tailscale sidecar.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
