# === Credential Vault Environment Variables ===
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# IMPORTANT: Generate strong random values for all secrets!

# === Application ===
APP_ENV=development
APP_DEBUG=true

# === Security (REQUIRED - Generate with: openssl rand -hex 32) ===
SECRET_KEY=your-secret-key-min-32-chars-change-this
ENCRYPTION_KEY=your-encryption-key-for-credentials-change-this

# === Database ===
DB_USER=vault
DB_PASSWORD=change-this-strong-password
DB_NAME=credential_vault
# Full URL (constructed in docker-compose, but can override)
# DATABASE_URL=postgresql+asyncpg://vault:password@localhost:5432/credential_vault

# === MFA Settings ===
MFA_ISSUER=CredentialVault
# MFA_REQUIRED=true

# === Session Settings ===
SESSION_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60

# === Initial Admin Bootstrap (optional) ===
# Set these to auto-create an admin user on first startup
# Only creates if no admin exists yet
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-strong-admin-password
# ADMIN_DISPLAY_NAME=Administrator

# === Tailscale (REQUIRED for production) ===
# Generate auth key at: https://login.tailscale.com/admin/settings/keys
# Settings: Reusable=Yes, Ephemeral=No
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_HOSTNAME=credential-vault
TS_CERT_DOMAIN=credential-vault.your-tailnet.ts.net

# Require requests to come from Tailscale network
REQUIRE_TAILSCALE=true

# Allowed Tailscale IP ranges (CGNAT range used by Tailscale)
TS_ALLOWED_RANGES=100.64.0.0/10
