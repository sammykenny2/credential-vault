# === Credential Vault Environment Variables ===
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# IMPORTANT: Generate strong random values for all secrets!

# === Application ===
APP_ENV=development
APP_DEBUG=true

# === Security (REQUIRED - Generate with: openssl rand -hex 32) ===
SECRET_KEY=your-secret-key-min-32-chars-change-this
ENCRYPTION_KEY=your-encryption-key-for-credentials-change-this

# === Database ===
DB_USER=vault
DB_PASSWORD=change-this-strong-password
DB_NAME=credential_vault
# Full URL (constructed in docker-compose, but can override)
# DATABASE_URL=postgresql+asyncpg://vault:password@localhost:5432/credential_vault

# === MFA Settings ===
MFA_ISSUER=CredentialVault
# MFA_REQUIRED=true

# === Session Settings ===
SESSION_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60

# === Tailscale (Optional - for verification) ===
# TAILSCALE_TAILNET=your-tailnet.ts.net
# REQUIRE_TAILSCALE=true
